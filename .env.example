# 🔐 Public key used on client side for login-related cookie validation
NEXT_PUBLIC_COOKIES_SECRET_LOGIN_KEY=your_public_cookie_secret_key_here

# 🔒 Server-side key used to sign and verify secure cookies
COOKIES_SECRET_KEY=your_secure_server_cookie_secret_here

# 🌐 Base URL of your frontend application (used in API calls, redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 🔗 URL of your backend server (for calling APIs from frontend)
NEXT_PUBLIC_BACKEND_URL=https://api2.ustudy.io.vn
